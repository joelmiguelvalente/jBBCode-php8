{
    "name": "jbbcode/jbbcode",
    "type": "library",
    "description": "A lightweight but extensible BBCode parser written in PHP 8.3.",
    "keywords": ["BBCode", "BB"],
    "homepage": "http://jbbcode.com/",
    "license": "MIT",
    "require": {
        "php": ">=8.2.0"
    },
    "require-dev": {
        "phpunit/phpunit": "^9.6",
        "friendsofphp/php-cs-fixer": "^3.0"
    },
    "authors": [
        {
            "name": "Jackson Owens",
            "email": "jackson_owens@alumni.brown.edu",
            "homepage": "http://jbowens.org/",
            "role": "Developer"
        }
    ],
    "autoload": {
        "psr-0": {
            "JBBCode": "."
        }
    },
    "minimum-stability": "stable",
    "scripts": {
        "test": "phpunit",
        "cs-fix": "php-cs-fixer fix"
    }
}
